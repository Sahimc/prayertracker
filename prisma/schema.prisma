generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Organization {
  id                             String       @id @default(cuid())
  name                           String
  town                           String
  slug                           String       @unique
  prayerCity                     String       @default("London")
  prayerCountry                  String       @default("GB")
  prayerTimezone                 String       @default("Europe/London")
  prayerCalculationMethod        Int          @default(3)
  prayerSchool                   Int          @default(0)
  prayerLatitudeAdjustmentMethod Int          @default(3)
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  admins                         Admin[]
  classes                        Class[]
  students                       Student[]
  prayerLogs                     PrayerLog[]
  prayerTimes                    PrayerTime[]
}

model Class {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students       Student[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId])
}

model Admin {
  id             String       @id @default(cuid())
  organizationId String
  fullName       String
  normalizedName String
  birthMonth     Int
  birthYear      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, normalizedName, birthMonth, birthYear])
  @@index([organizationId])
}

model Student {
  id             String       @id @default(cuid())
  organizationId String
  classId        String
  fullName       String
  normalizedName String
  birthMonth     Int
  birthYear      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  prayers        PrayerLog[]

  @@unique([organizationId, classId, normalizedName, birthMonth, birthYear])
  @@index([organizationId, classId])
  @@index([organizationId])
}

model PrayerLog {
  id             String       @id @default(cuid())
  organizationId String
  studentId      String
  date           String
  fajr           Boolean      @default(false)
  dhuhr          Boolean      @default(false)
  asr            Boolean      @default(false)
  maghrib        Boolean      @default(false)
  isha           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([organizationId, date])
}

model PrayerTime {
  id             String       @id @default(cuid())
  organizationId String
  date           String
  fajr           String
  dhuhr          String
  asr            String
  maghrib        String
  isha           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId])
}
